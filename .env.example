# Copy to .env (gitignored) and fill in. Do not commit real secrets.
# For datacosmos-br deployments, source ODOO_PASSWORD from the org secret
# DATACOSMOS_ODOO_PASSWORD and POSTGRES_PASSWORD from your cluster secret.
ODOO_HOST=web
ODOO_DB=odoodb
ODOO_SSL=false
ODOO_PORT=8069
ODOO_USERNAME=admin
ODOO_PASSWORD=__SET_ME__
POSTGRES_DB=odoodb
POSTGRES_USER=odoo
POSTGRES_PASSWORD=__SET_ME__
